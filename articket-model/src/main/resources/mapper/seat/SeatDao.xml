<!-- method-->
    <!-- 依場館 ID 與座位代號查詢座位 ID -->
    <select id="findSeatIdByVenueIdAndSeatName"
            resultType="java.lang.Integer">
        SELECT
            seat_id
        FROM
            seat
        WHERE
            venue_id = #{venueId}
            AND
            seat_name = #{seatName}
    </select>
