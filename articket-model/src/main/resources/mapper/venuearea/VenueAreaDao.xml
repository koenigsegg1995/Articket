    <select id="findVenueAreaIdByVenueIdAndVenueAreaName"
            resultType="java.lang.Integer">
        SELECT
            venue_area_id
        FROM
            venue_area
        WHERE
            venue_id = #{venueId}
            AND
            venue_area_name = #{venueAreaName}
