<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.maddog.articket.articlecollection.dao.ArticleCollectionDao">

<!-- sql -->

<!-- sql -->

<!-- resultMap-->
    <resultMap id="resultMapForSelect" type="com.maddog.articket.articlecollection.entity.ArticleCollection">
        <id column="article_collection_id" property="articleCollectionId" />
        <result column="member_id" property="memberId" />
        <result column="article_id" property="articleId" />
        <result column="collection_create_time" property="collectionCreateTime" />
    </resultMap>

    <resultMap id="resultMapForJoinArticle" type="com.maddog.articket.articlecollection.entity.ArticleCollection">
        <result column="article_collection_id" property="articleCollectionId" />
        <result column="member_id" property="memberId" />
        <result column="article_id" property="articleId" />
        <result column="collection_create_time" property="collectionCreateTime" />
        <result column="collection_create_time" property="collectionCreateTime" />
    </resultMap>

    <resultMap id="resultMapForView"
                type="com.maddog.articket.articlecollection.dto.ArticleCollectionForView">
        <result column="article_id" property="articleCategory" />
        <result  column="article_category" property="articleCategory" />
        <result column="articleTitle" property="articleTitle" />
        <result column="member_name" property="memberName" />
        <result column="board_name" property="boardName" />
        <result column="article_create_time" property="collectionCreateTime" />
    </resultMap>
<!-- resultMap-->

<!-- method-->
    <!-- 新增 -->
    <insert id="insert"
            parameterType="com.maddog.articket.articlecollection.entity.ArticleCollection">
        INSERT INTO article_collection
        (
            member_id,
            article_id,
            collection_create_time
        ) VALUES (
            #{memberId},
            #{articleId},
            #{collectionCreateTime}
        )
    </insert>

    <!-- 依活動收藏 ID 查詢 -->
    <select id="findById"
            parameterType="java.lang.Integer"
            resultMap="resultMapForSelect">
        SELECT
            *
        FROM
            article_collection
        WHERE
            article_collection_id = #{articleCollectionId}
    </select>

    <!-- 依活動收藏 ID 刪除 -->
    <delete id="deleteById"
            parameterType="java.lang.Integer">
        DELETE FROM
            article_collection
        WHERE
            article_collection_id = #{articleCollectionId}
    </delete>

    <!-- 會員對特定文章的收藏記錄 -->
    <select id="findByMemberAndArticle"
            resultMap="resultMapForSelect">
        SELECT
            *
        FROM
            article_collection
        WHERE
            member_id = #{memberId}
            AND
            article_id = #{articleId}
    </select>

    <!-- 依文章 ID 查詢收藏數量 -->
    <select id="countByArticleId"
            resultType="java.lang.Integer">
        SELECT
            COUNT(*)
        FROM
            article_collection
        WHERE
            article_id = #{articleId}
    </select>

    <!-- 依會員 ID 查詢文章收藏 VO 清單 -->
    <select id="findByMemberIdForView"
            parameterType="java.lang.Integer"
            resultMap="resultMapForView">
        SELECT
            ac.article_id,
            ac.collection_create_time,
            a.article_category,
            a.article_title,
            gm.member_name,
            b.board_name
        FROM
            article_collection ac
        JOIN
            article a
            ON
            ac.article_id = a.article_id
        JOIN
            general_member gm
            ON
            ac.member_id = gm.member_id
        JOIN
            board b
            ON
            a.board_id = b.board_id
        WHERE
            ac.member_id = #{memberId}
        ORDER BY
            ac.collection_create_time DESC
    </select>
<!-- method-->

</mapper>