<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.maddog.articket.news.dao.NewsDao">

<!-- sql -->
    <!-- 新增欄位 -->
    <sql id="columnsForInsert">
        administrator_id,
        news_title,
        news_content,
        news_status
    </sql>
<!-- sql -->

<!-- resultMap-->
    <!-- 全查詢 -->
    <resultMap id="resultForSelect" type="com.maddog.articket.news.entity.News">
        <id property="newsId" column="news_id" />
        <result property="administratorId" column="administrator_id" />
        <result property="newsTitle" column="news_title" />
        <result property="newsContent" column="news_content" />
        <result property="newsStatus" column="news_status" />
        <result property="newsCreateTime" column="news_create_time" />
    </resultMap>
<!-- resultMap-->

<!-- method-->
    <!-- 新增 -->
    <insert id="insert"
            parameterType="com.maddog.articket.news.entity.News">
        INSERT INTO news
        (
            <include refid="columnsForInsert" />
        )
        VALUES
        (
            #{administratorId},
            #{newsTitle},
            #{newsContent},
            #{newsStatus}
        )
    </insert>

    <!-- 更新 -->
    <insert id="update"
            parameterType="com.maddog.articket.news.entity.News">
        UPDATE
            news
        <set>
            <if test=" administratorId != null ">
                administrator_id = #{administratorId},
            </if>

            <if test=" newsTitle != null and newsTitle != '' ">
                news_title = #{newsTitle},
            </if>

            <if test=" newsContent != null and newsContent != '' ">
                news_content = #{newsContent},
            </if>

            <if test=" newsStatus != null ">
                news_status = #{newsStatus},
            </if>
        </set>
        WHERE
            news_id = #{newsId}
    </insert>

    <!-- 刪除 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM
            news
        WHERE
            news_id = #{newsId}
    </delete>

    <!-- 依消息 ID 查詢 -->
    <select id="findById"
            parameterType="java.lang.Integer"
            resultMap="resultForSelect">
        SELECT
            *
        FROM
            news
        WHERE
            news_id = #{newsId}
    </select>

    <!-- 查詢全部並分頁 -->
    <select id="findAllPaginated" resultMap="resultForSelect">
        SELECT
            *
        FROM
            news
        ORDER BY
            news_create_time desc
        <if test=" size != null and offset != null ">
            LIMIT #{size} OFFSET #{offset}
        </if>
    </select>

    <!-- 計算全部最新消息筆數 -->
    <select id="countAll"
            resultType="java.lang.Integer">
        SELECT
            COUNT(*)
        FROM
            news
    </select>
<!-- method-->

</mapper>