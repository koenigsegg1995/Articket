<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.maddog.articket.board.dao.BoardDao">

<!-- sql -->

<!-- sql -->

<!-- resultMap-->
    <resultMap id="resultMapForSelect"
                type="com.maddog.articket.board.entity.Board">
        <id column="board_id" property="boardId" />
        <result column="board_name" property="boardName" />
    </resultMap>
<!-- resultMap-->

<!-- method-->
    <!-- 查詢所有文章各板 -->
    <select id="findAll"
            resultMap="resultMapForSelect">
        SELECT
            *
        FROM
            board
        ORDER BY
            board_id DESC
    </select>
<!-- method-->

</mapper>